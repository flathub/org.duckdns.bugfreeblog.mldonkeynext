{
  "app-id": "org.duckdns.bugfreeblog.mldonkeynext",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "base": "io.qt.qtwebengine.BaseApp",
  "base-version": "6.10",
  "command": "mldonkey-next",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--device=dri",
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11"
  ],
  "modules": [
    {
      "name": "mldonkey-next",
      "buildsystem": "cmake-ninja",
      "subdir": "app",
      "config-opts": [
        "-DMLDONKEY_FLATHUB_QUIRKS=ON"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/carlonluca/mldonkey-next.git",
          "tag": "v1.4.0"
        },
        {
          "type": "archive",
          "url": "https://github.com/carlonluca/mldonkey-next/releases/download/v1.4.0/webapp-v1.4.0.zip",
          "dest": "app/webapp",
          "sha256": "43ab914b36ad4df69ac95206a680d9bbe4c96c8ece924c9e3d405dc4f9d6507b"
        }
      ]
    }
  ]
}
